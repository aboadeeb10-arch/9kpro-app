<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <TextView android:id="@+id/wopen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:drawablePadding="6dp" android:paddingBottom="6dp"/>
    <TextView android:id="@+id/w1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EDF5" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="4dp" android:drawableStart="@android:drawable/ic_media_play" android:drawablePadding="6dp" android:drawableTint="#16A2DA"/>
    <TextView android:id="@+id/w2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EDF5" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="4dp" android:drawableStart="@android:drawable/ic_media_play" android:drawablePadding="6dp" android:drawableTint="#16A2DA"/>
    <TextView android:id="@+id/w3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EDF5" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="4dp" android:drawableStart="@android:drawable/ic_media_play" android:drawablePadding="6dp" android:drawableTint="#16A2DA"/>
    <TextView android:id="@+id/w4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EDF5" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="4dp" android:drawableStart="@android:drawable/ic_media_play" android:drawablePadding="6dp" android:drawableTint="#16A2DA"/>
</LinearLayout>
